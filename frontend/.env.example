# ---- Python audit service (FastAPI) ----
# Local:      http://localhost:8000
# Production: https://your-app.up.railway.app
PYTHON_API_URL=http://localhost:8000

# ---- Supabase ----
# Same project as the Python backend. URL + anon key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used by route handlers to
# enforce scan quota, since that must not be client-editable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Abuse limits for free scans ----
# Scans require no account, so these guard API spend. Rolling 24h window.
FREE_SCANS_PER_EMAIL=3
FREE_SCANS_PER_IP=10


# -----------------------------------------------------------------------------
# 4. EMAIL DELIVERY (Hostinger SMTP)
# -----------------------------------------------------------------------------
# Reports are emailed from your hello@ mailbox. Create it in Hostinger under
# Emails > Email Accounts, then put its password below.
# Leave SMTP_PASSWORD empty to disable sending; scans still work.
#
# ALWAYS wrap the password in double quotes. An unquoted # starts a comment,
# so a password containing one is silently truncated and login fails with
# "535 authentication failed".
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@orb-itworks.com
SMTP_PASSWORD=""
SMTP_FROM=Orbit Works <hello@orb-itworks.com>
SMTP_REPLY_TO=hello@orb-itworks.com


# -----------------------------------------------------------------------------
# 5. LINKS
# -----------------------------------------------------------------------------
# Every "book a strategy session" button points here.
# Confirm the slug in your Calendly dashboard — the default is a guess.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/orbitworks/30min

# Used to build absolute links inside emails.
NEXT_PUBLIC_SITE_URL=https://scan.orb-itworks.com
