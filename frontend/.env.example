# ---- Python audit service (FastAPI) ----
# Local:      http://localhost:8000
# Production: https://your-app.up.railway.app
PYTHON_API_URL=http://localhost:8000

# ---- Supabase ----
# Same project as the Python backend. URL + anon key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used by route handlers to
# enforce scan quota, since that must not be client-editable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Abuse limits for free scans ----
# Scans require no account, so these guard API spend. Rolling 24h window.
FREE_SCANS_PER_EMAIL=3
FREE_SCANS_PER_IP=10
